      "quiz": [
        {
          "q": "手工擦拭胶片时，异丙醇的浓度选哪一种？",
          "type": "single",
          "options": [
            "91% 或更高",
            "70%",
            "50%",
            "任意浓度"
          ],
          "answer": [
            0
          ],
          "why": "Kodak 技术资料写明异丙醇 91% 或更高为首选，70% 太湿，水分过多会降低去污效率。"
        },
        {
          "q": "哪一项做法会加重划伤？",
          "type": "single",
          "options": [
            "来回擦拭",
            "单向擦拭",
            "翻折擦拭布换面",
            "一块布只润湿一次"
          ],
          "answer": [
            0
          ],
          "why": "来回或画圈擦拭把颗粒压进布面并推过胶片表面，划伤因此加重。"
        },
        {
          "q": "下列哪些情形禁止或不宜使用溶剂清洁？",
          "type": "multi",
          "options": [
            "齿孔有损伤的胶片",
            "带磁性声轨的胶片",
            "彩色反转片未经废片测试",
            "未使用的新片",
            "扫描前的负片"
          ],
          "answer": [
            0,
            1,
            2,
            3
          ],
          "why": "指南与厂商资料分别排除了齿孔损伤片、磁性声轨片，未测试的染料影像风险未知。新片不清洁是为了省去摩擦带来的风险。扫描前的负片属于应当清洁的情形。"
        }
      ],
