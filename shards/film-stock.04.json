        ],
        "contrast": []
      },
      "quiz": [
        {
          "q": "如何把片基密度与显影雾分开？",
          "type": "single",
          "options": [
            "在透射位置读未曝光片的冲洗前密度，按标准显影后再读一次，两次读数相减",
            "在反射位置读相纸的密度",
            "在曲线中段取两点作差",
            "读取边缘码的年份"
          ],
          "answer": [
            0
          ],
          "why": "冲洗前的读数给出静态成分，显影后的读数给出静态加动态成分，差值即显影雾。反射位置用于相纸，不用于负片。"
        },
        {
          "q": "ISO 黑白负片测定中，速度点的密度取在什么位置？",
          "type": "single",
          "options": [
            "比基准与雾高零点一",
            "比基准与雾高零点二",
            "曲线肩部",
            "片基密度处"
          ],
          "answer": [
            0
          ],
          "why": "ASA 与 ISO 的基准为高于基准与雾零点一。GOST 2817-50 用零点二，因此同一批胶片在两套体系下的标注值不同。"
        },
        {
          "q": "灰雾升高时，下列哪些指标会下降或偏移？",
          "type": "multi",
          "options": [
            "反差",
            "有效感光度",
            "显影指数",
            "反差指数",
            "最高密度"
          ],
          "answer": [
            0,
            1,
            2
          ],
          "why": "最低密度上升而最高密度几乎不变，反差因此下降。基准点上移使显影指数偏移，实测感光度低于标称值。反差指数取直线段斜率，在直线段内不变。"
        }
      ],
