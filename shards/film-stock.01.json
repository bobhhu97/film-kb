      "quiz": [
        {
          "q": "曲线的趾部斜率主要影响什么？",
          "type": "single",
          "options": [
            "高光密度",
            "阴影反差",
            "最大密度",
            "片基厚度"
          ],
          "answer": [
            1
          ],
          "why": "趾部记录阴影，斜率决定阴影反差。"
        },
        {
          "q": "显影时间增加会使最大密度如何变化？",
          "type": "single",
          "options": [
            "上升",
            "下降",
            "不变",
            "先升后降"
          ],
          "answer": [
            0
          ],
          "why": "显影更完全，生成更多银，最大密度上升。"
        },
        {
          "q": "ISO 感光度公式中的常数是？",
          "type": "single",
          "options": [
            "0.2",
            "0.5",
            "0.8",
            "1.25"
          ],
          "answer": [
            2
          ],
          "why": "ANSI PH3.1 规定常数 0.8。"
        }
      ],
      "updated": "2026-01-10",
