              "c4": "加 HCA 则 5–10 min",
              "c5": "cookbook 第 12 章"
            },
            {
              "c1": "酸非硬化定影",
              "c2": "流水",
              "c3": "10–15 min",
              "c4": "HCA 1 min 连续搅",
              "c5": "cookbook 第 12 章"
