      "quiz": [
        {
          "q": "酸停显液的两个主要作用是什么？",
          "type": "single",
          "options": [
            "冷却胶片、提高片速",
            "停止显影并把胶片调到适于硬化定影液的 pH",
            "补充银盐",
            "去除水"
          ],
          "answer": [
            1
          ],
          "why": "停显的第二个作用决定酸硬化定影液的寿命，比单纯停显更实用。"
        },
        {
          "q": "理想缓冲停显液的 pH 是多少？",
          "type": "single",
          "options": [
            "2.5",
            "3.0",
            "4.5",
            "6.5"
          ],
          "answer": [
            2
          ],
          "why": "pH 4.5 兼顾停止速度与明胶稳定，pH 5 为安全上限。"
        },
        {
          "q": "定影时间应如何确定？",
          "type": "single",
          "options": [
            "固定 5 分钟",
            "清透时间的 2–3 倍，最少 3 分钟",
            "清透时间的一半",
            "与显影时间相同"
          ],
          "answer": [
            1
          ],
          "why": "定影时间是清透时间的安全倍数。过定影降低影像永久性。"
        },
        {
          "q": "碱性定影液相对酸定影液的关键优势是什么？",
          "type": "single",
          "options": [
            "价格低",
            "不溶解银影像，过定影无损失且水洗快",
            "气味小到无味",
            "不需要搅拌"
          ],
          "answer": [
            1
          ],
          "why": "硫代硫酸盐在碱性条件不与银影像媒染，因此提高永久性并缩短水洗。"
        }
      ],
      "updated": "2026-01-12",
