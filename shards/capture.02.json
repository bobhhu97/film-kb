    {
      "id": "capture.film-transport",
      "title": "过片、倒片与暗盒",
      "title_en": "Film Transport, Rewind and Cassettes",
      "aliases": [
        "过片",
        "film advance",
        "倒片",
        "rewind",
        "暗盒",
        "cassette",
        "dark slide",
        "片基朝向",
        "film base orientation"
      ],
      "type": "process",
      "level": 3,
      "era": "1925 至今",
      "tags": [
        "过片",
        "倒片",
        "暗盒",
        "片基",
        "操作"
      ],
      "summary": "过片把胶片按格距送到片门。倒片把曝光后的胶片卷回暗盒。装片方向与片基朝向决定影像方向与漏光位置。",
      "blocks": [
        {
          "kind": "h2",
          "text": "手动过片节奏"
        },
        {
          "kind": "steps",
          "items": [
            {
              "t": "推满过片扳手",
              "d": "扳手一次推到最大行程。中途停手会让胶片停在格间位置。"
            },
            {
              "t": "核对计数",
              "d": "确认计数数字跳到下一格。多数机身在扳手未推满时锁住快门。"
            },
            {
              "t": "确认反光镜复位",
              "d": "扳手末端行程把反光镜放回取景光路。取景器变清晰即为复位。"
            },
            {
              "t": "听到定位声后松手",
              "d": "棘爪声表示到位。轻轻松手可延长棘爪寿命。"
            }
          ]
