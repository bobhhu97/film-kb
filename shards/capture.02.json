        ],
        "contrast": []
      },
      "quiz": [
        {
          "q": "哪一类像差在收小光圈后减轻最明显？",
          "type": "single",
          "options": [
            "色差",
            "球差",
            "场曲",
            "畸变"
          ],
          "answer": [
            1
          ],
          "why": "球差随光束高度增大而增大，收小光圈直接减少光束高度。"
        },
        {
          "q": "画面边缘的直线变成枕形，属于哪一类像差？",
          "type": "single",
          "options": [
            "像散",
            "彗差",
            "畸变",
            "场曲"
          ],
          "answer": [
            2
          ],
          "why": "畸变表现为放大率随像场变化，枕形与桶形是两个方向。"
        },
        {
          "q": "消三色色差的镜头叫什么？",
          "type": "single",
          "options": [
            "消色差 achromatic",
            "复消色差 apochromatic",
            "消像散 anastigmatic",
            "正像 orthoscopic"
          ],
          "answer": [
            1
          ],
          "why": "消两色为 achromatic，消三色为 apochromatic。"
        }
      ],
      "updated": "2026-10-09",
      "status": "reviewed"
    },
