      "quiz": [
        {
          "q": "焦平面快门的 X 同步速度主要由什么决定？",
          "type": "single",
          "options": [
            "帘幕行程与缝隙通过时间",
            "镜头最大光圈",
            "胶片感光度",
            "反光镜尺寸"
          ],
          "answer": [
            0
          ],
          "why": "闪光持续时间必须覆盖缝隙通过片门的时间，行程决定缝隙宽度。"
        },
        {
          "q": "叶片快门的最高速度通常是多少？",
          "type": "single",
          "options": [
            "1/60 s",
            "1/500 s",
            "1/2000 s",
            "1/8000 s"
          ],
          "answer": [
            1
          ],
          "why": "叶片叠合需要行程时间，叶片快门典型上限为 1/500 s。"
        },
        {
          "q": "长曝光时锁住反光镜会带来什么影响？",
          "type": "single",
          "options": [
            "取景器变亮",
            "测光与自动对焦停止工作",
            "快门速度提高一档",
            "压片板自动前移"
          ],
          "answer": [
            1
          ],
          "why": "反光镜锁起后测光元件被遮挡，自动对焦也失去反射光。"
        }
      ],
      "updated": "2026-10-09",
      "status": "reviewed"
    },
    {
      "id": "capture.lens",
      "title": "镜头：焦距、光圈与卡口",
      "title_en": "Photographic Lens: Focal Length, Aperture and Mount",
      "aliases": [
        "镜头",
        "lens",
        "焦距",
        "focal length",
        "光圈",
        "aperture",
        "f-number",
        "视角",
        "angle of view",
        "法兰距",
        "flange distance"
      ],
      "type": "concept",
      "level": 3,
      "era": "1920 至今",
      "tags": [
        "镜头",
        "焦距",
        "光圈",
        "卡口",
        "视角"
      ],
      "summary": "镜头由镜组、光圈与卡口组成。焦距决定视角，光圈决定进光量与景深。卡口决定镜头与机身的兼容范围。",
      "blocks": [
        {
          "kind": "h2",
          "text": "焦距与视角"
        },
        {
          "kind": "p",
          "text": "焦距（focal length）以毫米计。焦距越长视角越窄。焦距越短视角越宽。视角由焦距与画幅对角线之比决定。画幅规格见 $capture.camera-format。"
        },
        {
          "kind": "image",
          "src": "img/aperture-blades.jpg",
          "alt": "奥林巴斯 Zuiko OM 50 mm f/1.8 镜头，可见六片光圈叶片形成的多边形通光孔。",
          "caption": "奥林巴斯 Zuiko OM 50 mm f/1.8 镜头，可见六片光圈叶片形成的多边形通光孔。",
          "credit": "Petar Milošević",
          "license": "CC BY-SA 4.0",
          "source": "https://commons.wikimedia.org/wiki/File%3AOlympus_Zuiko_OM_50_mm_lens.jpg"
        },
        {
          "kind": "table",
          "caption": "135 画幅常用焦距与用途",
          "rows": [
            {
              "c1": "18–24 mm",
              "c2": "超广角",
              "c3": "室内空间与大幅风景",
              "c4": "边缘变形明显",
              "c5": "需短后焦或特定设计"
            },
            {
              "c1": "28–35 mm",
              "c2": "广角",
              "c3": "纪实与环境人像",
              "c4": "透视夸张",
              "c5": "常用大三元焦段之一"
            },
            {
              "c1": "43–60 mm",
              "c2": "标准",
              "c3": "日常与人像",
              "c4": "透视接近人眼",
              "c5": "50 mm 最常见"
            },
            {
              "c1": "85–135 mm",
              "c2": "中长焦",
              "c3": "人像与远景",
              "c4": "透视压缩",
              "c5": "工作距离较远"
            },
            {
              "c1": "200 mm 以上",
              "c2": "长焦",
              "c3": "远处细节与压缩透视",
              "c4": "景深很浅",
              "c5": "手持需更快速度"
            }
          ]
        },
        {
          "kind": "p",
          "text": "135 画幅的对角线约 43 mm。厂商把 43 mm 到 60 mm 的镜头列为标准镜头。视角换算按画幅对角线比例计算。"
        },
        {
          "kind": "h2",
          "text": "光圈与 f 值"
        },
        {
          "kind": "defs",
          "term": "光圈数（f-number）",
          "text": "光圈数等于焦距除以有效孔径直径。数值越小进光量越大。f/2 的进光量是 f/4 的四倍。标定 f 值时按镜头的最大通光孔径计算。"
        },
        {
          "kind": "p",
          "text": "收小光圈可减小球差（spherical aberration）。f/16 以上的衍射使细节变软。厂商标称 f/2.8 通常指全开时的分辨表现。各类像差见 $capture.lens-aberrations。"
        },
        {
          "kind": "p",
          "text": "收小光圈可减小球差（spherical aberration）。f/16 以上的衍射使细节变软。厂商标称 f/2.8 通常指全开时的分辨表现。各类像差见 $capture.lens-aberrations。"
        },
        {
          "kind": "h2",
          "text": "卡口与转接"
        },
        {
          "kind": "p",
          "text": "卡口（lens mount）由法兰距与卡爪形式决定。法兰距（flange distance）是卡口面到胶片平面的距离。机身法兰距大于镜头法兰距时，镜头可在无穷远合焦。"
        },
        {
          "kind": "p",
          "text": "Leica M 卡口于 1954 年推出，法兰距为 27.8 mm。Nikon F 卡口于 1959 年推出。Canon FD 卡口于 1971 年 3 月推出，法兰距为 42 mm。Canon EF 卡口于 1987 年推出，法兰距为 44 mm。沿革细节见 $capture.mount-history。"
        },
        {
          "kind": "p",
          "text": "转接环只解决机械连接。老镜头装到 FD 机身的转接环上仍能在无穷远合焦。测光与自动光圈需要额外的耦合件。镜片与滤镜的影响见 $capture.filter。"
        },
        {
          "kind": "h2",
          "text": "常见镜头机械故障"
        },
        {
          "kind": "troubleshoot",
          "caption": "镜头机械故障排查",
          "items": [
            {
              "t": "光圈拨杆松手后不回位",
              "d": "拨杆机构积垢或弹簧疲劳。拆开光圈环，清洗后加少量润滑脂。"
            },
            {
              "t": "全焦位合焦失败",
              "d": "转接环法兰距错误，或机身与镜头组合厚度超差。核对卡口与法兰距数据。"
            },
            {
              "t": "卡口松旷、镜头松动",
              "d": "卡爪磨损或螺丝松动。紧固螺丝，磨损严重的卡口环需要更换。"
            },
            {
              "t": "边缘画质突然下降",
              "d": "镜片霉菌或油污。检查前组与后组，镜片清洁另见 $archive.cleaning-and-handling。"
            }
          ]
        }
      ],
